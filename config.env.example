# Database Configuration
DATABASE_URL=postgresql://admin:password@localhost:5432/streaming_analytics
REDIS_URL=redis://localhost:6379

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_USER_EVENTS=user_events
KAFKA_TOPIC_ANALYTICS=analytics_events
KAFKA_GROUP_ID=analytics_processor

# Spark Configuration
SPARK_MASTER_URL=spark://localhost:7077
SPARK_APP_NAME=StreamingAnalyticsPipeline
SPARK_EXECUTOR_MEMORY=2g
SPARK_DRIVER_MEMORY=1g

# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET=streaming-analytics-data

# GCP Configuration
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
GCP_PROJECT_ID=your-project-id
GCS_BUCKET=streaming-analytics-data

# Application Configuration
LOG_LEVEL=INFO
BATCH_SIZE=1000
CHECKPOINT_INTERVAL=60
WINDOW_DURATION=300
SLIDE_DURATION=60

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
